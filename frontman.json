{
	"provider": "jsdelivr",
	"destination": "simple_resume/static",
	"packages": [
		{
			"name": "@fontsource/roboto",
			"version": "5.0.14",
			"destination": "fonts/roboto",
			"files": [
				"files/roboto-latin-300-normal.woff2",
				"files/roboto-latin-400-italic.woff2",
				"files/roboto-latin-400-normal.woff2",
				"files/roboto-latin-500-normal.woff2",
				"latin-300.css",
				"latin-400-italic.css",
				"latin-400.css",
				"latin-500.css"
			]
		},
		{
			"name": "@radix-ui/colors",
			"version": "3.0.0",
			"destination": "styles/radix-colors",
			"files": [
				"amber.css",
				"blue.css",
				"bronze.css",
				"brown.css",
				"crimson.css",
				"cyan.css",
				"gold.css",
				"grass.css",
				"gray.css",
				"green.css",
				"indigo.css",
				"iris.css",
				"jade.css",
				"lime.css",
				"mauve.css",
				"mint.css",
				"olive.css",
				"orange.css",
				"pink.css",
				"plum.css",
				"purple.css",
				"red.css",
				"ruby.css",
				"sage.css",
				"sand.css",
				"sky.css",
				"slate.css",
				"teal.css",
				"tomato.css",
				"violet.css",
				"yellow.css"
			]
		},
		{
			"name": "bootstrap-icons",
			"version": "1.11.3",
			"destination": "icons",
			"files": [
				{
					"name": "bootstrap-icons.svg",
					"rename": "bootstrap.svg"
				}
			]
		},
		{
			"name": "open-color",
			"version": "1.9.1",
			"destination": "styles",
			"files": ["open-color.css"]
		},
		{
			"name": "reasonable-colors",
			"version": "0.4.0",
			"destination": "styles",
			"files": ["reasonable-colors.css"]
		},
		{
			"name": "sanitize.css",
			"version": "13.0.0",
			"destination": "styles",
			"files": ["sanitize.min.css"]
		}
	]
}
