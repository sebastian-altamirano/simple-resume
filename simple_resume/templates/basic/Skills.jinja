{#def skills #}

<SectionTitle :title="_('Skills')" />

<ul class="skills">
	{% for skills_group in skills %}
		<li class="skills-group">
			<Entry>
				<h3 class="skills-group__name">{{ skills_group.name | addcolon }}</h3>

				<Tags :tags="skills_group.keywords" />
			</Entry>
		</li>
	{% endfor %}
</ul>
