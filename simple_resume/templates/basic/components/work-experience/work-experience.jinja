{% from 'components/section-item/section-item.jinja' import sectionItem %}
{% from 'components/section-title/section-title.jinja' import sectionTitle %}

{% macro workExperience(experiences=[]) %}
	{{ sectionTitle(_('Experience')) }}

	<ul class="work-experiences">
		{% for experience in experiences %}
			<li class="work-experience">
				{{
					sectionItem(
						experience.position,
						experience.name,
						experience.startDate,
						experience.endDate,
						experience.summary,
						experience.highlights
					)
				}}
			</li>
		{% endfor %}
	</ul>
{%- endmacro %}
