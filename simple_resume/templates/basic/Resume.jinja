{#def file_name, resume #}
{#css
	fonts/roboto/latin-300.css,
	fonts/roboto/latin-400.css,
	fonts/roboto/latin-500.css,
	styles/bootstrap-icons.css,
	styles/radix-colors/gray.css,
	styles/radix-colors/indigo.css
#}

<Layout :file_name="file_name">
	<main class="resume">
		<header class="resume__header">
			<ContactInformation
				:name="resume.basics.name"
				:position="resume.basics.label"
				:city="resume.basics.location.city"
				:region="resume.basics.location.region"
				:country_code="resume.basics.location.country_code"
				:email="resume.basics.email"
				:phone="resume.basics.phone"
				:profiles="resume.basics.profiles"
			/>
		</header>
		<article class="resume__body">
			{% if resume.skills %}
				<section class="resume__section">
					<Skills :skills="resume.skills" />
				</section>
			{% endif %}
			{% if resume.work %}
				<section class="resume__section">
					<WorkExperience :work_experience="resume.work" />
				</section>
			{% endif %}
			{% if resume.education %}
				<section class="resume__section">
					<EducationHistory :education_history="resume.education" />
				</section>
			{% endif %}
		</article>
	</main>
</Layout>
