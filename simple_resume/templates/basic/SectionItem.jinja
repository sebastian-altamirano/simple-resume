{#def title, subtitle, start_date, end_date, summary = None, highlights = None #}

<Entry>
	<h3 class="section-item__heading">
		<span>{{ title }}</span>
		<span class="section-item__date-range"
			>{{ "%m-%Y" | daterangeformat(start_date, end_date) }}</span
		>
		<span class="section-item__subtitle">{{ subtitle }}</span>
	</h3>

	{% if summary %}<p class="section-item__summary">{{ summary }}</p>{% endif %}

	{% if highlights %}
		<ul class="section-item__highlights">
			{% for highlight in highlights %}<li>{{ highlight }}</li>{% endfor %}
		</ul>
	{% endif %}
</Entry>
